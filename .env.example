# Copia este archivo a .env y completa con tus credenciales reales de IOL.
# El archivo .env NO se sube al repo (esta en .gitignore).
IOL_USERNAME=tu_usuario_iol
IOL_PASSWORD=tu_clave_iol

# Solo hace falta si tu antivirus/proxy intercepta HTTPS (ver seccion
# Troubleshooting del README). Ruta absoluta a un bundle de certificados que
# incluya el certificado raiz de esa interceptacion + el bundle de certifi.
# REQUESTS_CA_BUNDLE=C:\ruta\completa\a\combined_ca.pem
